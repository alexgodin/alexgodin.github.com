rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "kanshin@zencare.org";
    }
    match /deceased/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /sick/{docId}     { allow read: if true; allow write: if isAdmin(); }
  }
}
